# Set to true when running behind a reverse proxy (e.g. Render) so rate limits use the real client address
TRUST_PROXY=false
MONGO_URL=mongodb+srv://<db-user>:<url-encoded-password>@<cluster-host>/<database>?retryWrites=true&w=majority
REDIS_URL=rediss://default:<redis-password>@<redis-host>:<redis-port>
JWT_SECRET=<long-random-string>
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174
PORT=5000

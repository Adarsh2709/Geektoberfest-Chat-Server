{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "chat-server-api": {
      "root": "backend",
      "framework": "express",
      "installCommand": "npm ci"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "chat-server-api"
      }
    },
    {
      "source": "/socket.io/(.*)",
      "destination": {
        "service": "chat-server-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}